generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  cargo     String
  createdAt DateTime @default(now())
}

model Paciente {
  id               String        @id @default(uuid())
  nome             String
  cpf              String        @unique
  data_nascimento  DateTime
  sexo             String
  whatsapp         String
  cep              String
  endereco         String
  numero           String
  bairro           String
  cidade           String
  uf               String
  nome_responsavel String?
  cpf_responsavel  String?
  parentesco       String?
  nome_mae         String?
  atendimentos     Atendimento[]
  createdAt        DateTime      @default(now())
}

model Atendimento {
  id            String   @id @default(uuid())
  pacienteId    String
  paciente      Paciente @relation(fields: [pacienteId], references: [id])
  servicoId     String?
  servico       Servico? @relation(fields: [servicoId], references: [id])
  status        String   @default("AGUARDANDO")
  prioridade    Boolean  @default(false)
  convenio      String   @default("PARTICULAR")
  numero_guia   String?
  sintomas      String?
  diagnostico   String?
  prescricao    String?
  exames_sadt   Sadt[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Sadt {
  id             String      @id @default(uuid())
  atendimentoId  String
  atendimento    Atendimento @relation(fields: [atendimentoId], references: [id])
  nome_exame     String
  observacoes    String?
  data_solicitado DateTime   @default(now())
  status         String      @default("PENDENTE")
}

model Servico {
  id           String        @id @default(uuid())
  nome         String
  descricao    String?
  valor        Float
  categoria    String
  atendimentos Atendimento[]
  createdAt    DateTime      @default(now())
}

model Produto {
  id          String   @id @default(uuid())
  nome        String
  quantidade  Int
  unidade     String   // ex: CX, UN, ML
  precoCusto  Float
  validade    DateTime?
  createdAt   DateTime @default(now())
}

model Campanha {
  id        String   @id @default(uuid())
  nome      String
  tema      String
  mensagem  String
  desconto  String?
  status    String   @default("RASCUNHO") // RASCUNHO, ENVIADA
  createdAt DateTime @default(now())
}