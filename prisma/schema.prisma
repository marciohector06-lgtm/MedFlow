// Configuração do Cliente Prisma
generator client {
  provider = "prisma-client-js"
}

// Configuração da Base de Dados baseada no .env 
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS PARA CONTROLO DE ACESSO E FLUXO ---

enum Role {
  SUPERADMIN
  RECEPCAO
  TRIAGEM
  MEDICO
}

enum StatusAtendimento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_CONSULTA
  EM_CONSULTA
  FINALIZADO
  AUSENTE_AGUARDANDO_RETORNO
}

// --- MODELOS DE UTILIZADORES E ACESSO ---

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
  role  Role   @default(RECEPCAO)
}

// --- MODELOS DO DOMÍNIO MÉDICO ---

model Paciente {
  id                Int           @id @default(autoincrement())
  nome              String
  cpf               String        @unique
  telefone          String
  data_nascimento   DateTime      
  responsavel_legal String?       
  nome_mae          String?       
  cep               String?
  endereco          String?
  atendimentos      Atendimento[]
}

model Procedimento {
  id           Int           @id @default(autoincrement())
  nome         String
  atendimentos Atendimento[]
}

model Atendimento {
  id              Int               @id @default(autoincrement())
  tipo            String?
  prioridade      Boolean           @default(false)
  status          StatusAtendimento @default(AGUARDANDO_TRIAGEM)
  
  // Relações
  paciente_id     Int
  paciente        Paciente          @relation(fields: [paciente_id], references: [id])
  
  procedimento_id Int
  procedimento    Procedimento      @relation(fields: [procedimento_id], references: [id])
  
  triagem         Triagem?
  createdAt       DateTime          @default(now())
}

model Triagem {
  id             Int         @id @default(autoincrement())
  atendimento_id Int         @unique
  atendimento    Atendimento @relation(fields: [atendimento_id], references: [id])
  
  pressao        String?
  peso           Float?
  sintomas       String
  classificacao  String      // Ex: VERMELHO, AMARELO, VERDE, AZUL
}